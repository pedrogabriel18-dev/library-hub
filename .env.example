# Acervo Digital EETIJA - variaveis para EasyPanel/Docker

NODE_ENV=production
PORT=3333

# SQLite persistente. No EasyPanel, monte um volume em /app/data.
DATABASE_URL=file:/app/data/sqlite.db

# Raiz usada pelo backend para localizar storage/books, storage/tccs e public/assets.
STORAGE_ROOT=/app

# Gere uma chave forte antes de publicar.
# Exemplo: openssl rand -hex 64
JWT_SECRET=troque_por_uma_chave_forte
JWT_EXPIRES_IN=7d

# Senha padrão criada para novos usuários (devem trocá-la no primeiro acesso).
# Substitua por uma senha forte antes de ir para produção.
DEFAULT_PASSWORD=Ler@2026

# URL publica da aplicacao no EasyPanel, sem barra final.
FRONTEND_URL=https://acervo.seudominio.com.br
